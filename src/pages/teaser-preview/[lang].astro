---
import ReleaseExperience from "../../components/ReleaseExperience";
import { releases, type Language } from "../../content/releases";
import "../../styles/global.css";

export function getStaticPaths() {
  return (["ru", "en"] as Language[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const release = releases[0];
const copy = release.copy[lang];
---

<!doctype html>
<html lang={lang}>
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /></head>
  <body style={`--color-background:${release.theme.background};--color-foreground:${release.theme.foreground};--color-muted:${release.theme.muted};--color-accent:${release.theme.accent}`}>
    <span class="release-arrow release-arrow--next release-arrow--teaser" role="note" tabindex="0" aria-label={copy.nextReleaseTeaser.replace("\n", " ")}>
      <img class="release-arrow__icon" src="/assets/ui/release-arrow.png" alt="" width="2105" height="2000" />
      <span class="release-arrow__preview" aria-hidden="true">
        <img src="/assets/ui/next-release-mark.png" alt="" width="2000" height="2000" />
        <span>{copy.nextReleaseTeaser}</span>
      </span>
    </span>
    <section class="release-hero" style={`--release-cover: url('${release.cover}')`}>
      <div class="release-hero__grain"></div>
      <div class:list={["release-hero__heading", { "release-hero__heading--stacked": Boolean(copy.heroTitle) }]}><p>{copy.eyebrow}</p><h1>{copy.heroTitle ?? copy.title}</h1></div>
      <ReleaseExperience client:load modelUrl={release.model} textureUrl={release.envelopeTexture} paperTextureUrls={release.paperTextures[lang]} sounds={release.interactionSounds} tracks={copy.tracks} hint={copy.interactionHint} closeText={copy.closeText} />
    </section>
  </body>
</html>
