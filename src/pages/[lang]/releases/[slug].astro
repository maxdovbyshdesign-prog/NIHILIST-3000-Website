---
import ReleaseExperience from "../../../components/ReleaseExperience";
import { getReleaseNeighbors, releases, type Language } from "../../../content/releases";
import SiteLayout from "../../../layouts/SiteLayout.astro";

export function getStaticPaths() {
  return releases.flatMap((release) =>
    (["ru", "en"] as Language[]).map((lang) => ({
      params: { lang, slug: release.slug },
      props: { lang, release },
    })),
  );
}

const { lang, release } = Astro.props;
const copy = release.copy[lang as Language];
const alternateLanguage: Language = lang === "ru" ? "en" : "ru";
const neighbors = getReleaseNeighbors(release.slug);
const description = `${release.artist} — ${copy.title}`;
---

<SiteLayout title={`${release.artist} — ${copy.title}`} description={description} lang={lang} theme={release.theme}>
  <header class="site-header">
    <a class="site-header__brand" href={`/${lang}/releases/${release.slug}`} aria-label="NIHILIST3000 home">
      <img src="/assets/ui/nihilist-mark.png" alt="" width="4000" height="4000" />
      <span>NIHILIST3000</span>
    </a>
    <span class="site-header__release">{copy.title}</span>
    <a
      class="site-header__language"
      href={`/${alternateLanguage}/releases/${release.slug}`}
      data-language-choice={alternateLanguage}
      aria-label={`Switch to ${alternateLanguage === "ru" ? "Russian" : "English"}`}
    >
      {lang === "ru" ? "RU / EN" : "EN / RU"}
    </a>
  </header>

  <nav class="release-navigation" aria-label="Release navigation">
    {
      neighbors.previous ? (
        <a
          class="release-arrow release-arrow--previous"
          href={`/${lang}/releases/${neighbors.previous.slug}`}
          aria-label={copy.previousRelease}
        >
          <img src="/assets/ui/release-arrow.png" alt="" width="2105" height="2000" />
        </a>
      ) : null
    }
    {
      neighbors.next ? (
        <a
          class="release-arrow release-arrow--next"
          href={`/${lang}/releases/${neighbors.next.slug}`}
          aria-label={copy.nextRelease}
        >
          <img src="/assets/ui/release-arrow.png" alt="" width="2105" height="2000" />
        </a>
      ) : (
        <button
          type="button"
          class="release-arrow release-arrow--next release-arrow--teaser"
          aria-expanded="false"
          aria-label={copy.nextReleaseTeaser.replace("\n", " ")}
        >
          <img class="release-arrow__icon" src="/assets/ui/release-arrow.png" alt="" width="2105" height="2000" />
          <span class="release-arrow__preview" aria-hidden="true">
            <img src="/assets/ui/next-release-mark.png" alt="" width="2000" height="2000" />
            <span>{copy.nextReleaseTeaser}</span>
          </span>
        </button>
      )
    }
  </nav>

  <main>
    <section class="release-hero" style={`--release-cover: url('${release.cover}')`}>
      <div class="release-hero__grain"></div>
      <div class:list={["release-hero__heading", { "release-hero__heading--stacked": Boolean(copy.heroTitle) }]}>
        <p>{copy.eyebrow}</p>
        <h1>{copy.heroTitle ?? copy.title}</h1>
      </div>
      <a class="release-hero__listen" href="#listen">
        <img src="/assets/ui/listen-headphones.png" alt="" width="2000" height="2000" />
        <span>{copy.servicesLabel}</span>
      </a>
      <ReleaseExperience
        client:load
        modelUrl={release.model}
        textureUrl={release.envelopeTexture}
        paperTextureUrls={release.paperTextures[lang as Language]}
        sounds={release.interactionSounds}
        tracks={copy.tracks}
        hint={copy.interactionHint}
        touchHint={copy.touchInteractionHint}
        closeText={copy.closeText}
      />
      <span class="release-hero__index">001 / {String(releases.length).padStart(3, "0")}</span>
    </section>

    <section class="content-section video-section" aria-labelledby="video-title">
      <div class="section-heading">
        <span>01</span>
        <h2 id="video-title">{copy.videoLabel}</h2>
      </div>
      {
        release.videoId ? (
          <iframe
            class="video-frame"
            src={`https://www.youtube-nocookie.com/embed/${release.videoId}`}
            title={`${release.artist} — ${copy.title}`}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          />
        ) : (
          <div class="video-placeholder" style={`--release-cover: url('${release.cover}')`}>
            <span class="video-placeholder__play">▶</span>
            <p>{copy.videoPending}</p>
          </div>
        )
      }
    </section>

    <section id="listen" class="content-section services-section" aria-labelledby="services-title">
      <div class="section-heading">
        <span>02</span>
        <h2 id="services-title">{copy.servicesLabel}</h2>
      </div>
      <div class="service-grid">
        {release.services.map((service) => (
          <a
            class="service-link"
            href={service.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>{service.name}</span>
            <small>{copy.servicesPending}</small>
            <img class="service-link__arrow outbound-arrow" src="/assets/ui/release-arrow.png" alt="" width="2105" height="2000" />
          </a>
        ))}
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-footer__identity">
      <a class="site-footer__brand" href={`/${lang}/releases/${release.slug}`} aria-label="NIHILIST3000 home">
        <img src="/assets/ui/nihilist-mark.png" alt="" width="4000" height="4000" />
        <span>NIHILIST3000</span>
      </a>
      <span class="site-footer__copyright">© {new Date().getFullYear()}</span>
    </div>
    <div class="site-footer__socials" aria-label={copy.socialsLabel}>
      {release.socials.map((social) => social.url ? (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {social.name}
          <img class="outbound-arrow" src="/assets/ui/release-arrow.png" alt="" width="2105" height="2000" />
        </a>
      ) : (
        <span>{social.name}</span>
      ))}
    </div>
  </footer>

  <script>
    const teaser = document.querySelector<HTMLButtonElement>(".release-arrow--teaser");
    teaser?.addEventListener("click", () => {
      const expanded = teaser.classList.toggle("is-active");
      teaser.setAttribute("aria-expanded", String(expanded));
    });
    document.addEventListener("pointerdown", (event) => {
      if (teaser && !teaser.contains(event.target as Node)) {
        teaser.classList.remove("is-active");
        teaser.setAttribute("aria-expanded", "false");
        teaser.blur();
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && teaser) {
        teaser.classList.remove("is-active");
        teaser.setAttribute("aria-expanded", "false");
        teaser.blur();
      }
    });
    document.querySelectorAll<HTMLElement>("[data-language-choice]").forEach((link) => {
      link.addEventListener("click", () => {
        const language = link.dataset.languageChoice;
        if (language) localStorage.setItem("nihilist3000-language", language);
      });
    });
  </script>
</SiteLayout>
